# Copia este fichero a .env y cambia los valores marcados.

# --- Acceso ---
# Puerto en el que se abre la app: http://localhost:8080 (o http://IP-del-equipo:8080)
APP_PORT=8080
# Usuario inicial (opcional). Si se dejan vacíos, la primera cuenta se crea desde la pantalla de entrada.
# Si se rellenan, se crea en el primer arranque; después la contraseña se cambia desde Ajustes.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Clave para firmar las sesiones. Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave
# Pon true solo si accedes por HTTPS (proxy inverso). En la red local por HTTP debe ser false.
COOKIE_SECURE=false
SESSION_DAYS=30
# Permitir crear cuentas nuevas desde la pantalla de entrada (false: solo desde Ajustes o la terminal).
# La primera cuenta de una instalación nueva se puede crear siempre.
ALLOW_REGISTRATION=true

# --- Base de datos ---
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia-esta-contraseña-de-bd
POSTGRES_DB=finanzas

# --- Regional ---
TZ=Europe/Madrid
# Festivos por defecto para mover pagos a día hábil: país y región (p. ej. VC = Comunitat Valenciana;
# vacío = solo nacionales). Cada usuario elige los suyos al crear la cuenta y puede cambiarlos en Ajustes.
HOLIDAYS_COUNTRY=ES
HOLIDAYS_SUBDIV=

# --- Recurrentes ---
# Meses hacia el futuro para los que se generan las ocurrencias previstas
OCCURRENCE_HORIZON_MONTHS=18

# --- Adjuntos ---
MAX_ATTACHMENT_MB=15

# --- Copias de seguridad ---
# Carpeta del equipo donde se guardan las copias
BACKUP_DIR=./backups
# Se hace una copia al arrancar si la última tiene más de estas horas, y se revisa cada hora
BACKUP_INTERVAL_HOURS=24
# Se borran las copias con más de estos días...
BACKUP_RETENTION_DAYS=30
# ...pero siempre se conservan al menos estas (útil si el equipo pasa semanas apagado)
BACKUP_MIN_KEEP=7
